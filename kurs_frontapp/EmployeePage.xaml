<Page x:Class="kurs_frontapp.EmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Працівники">
    <Grid>
        <DataGrid x:Name="EmployeesGrid" Margin="5" 
                 AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding employee_id}" Width="Auto"/>
                <DataGridTextColumn Header="Прізвище" Binding="{Binding last_name}" Width="150"/>
                <DataGridTextColumn Header="Логін" Binding="{Binding login}" Width="120"/>
                <DataGridTextColumn Header="Посада" Binding="{Binding position_}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>